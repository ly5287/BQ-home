{{- /* 生成完整纯文本搜索索引，提取 opt-content 和 paragraphMap 中的隐藏内容 */ -}}
{{- $pages := where site.RegularPages ".Params.pagefind" "!=" false -}}
{{- $pages = where $pages "Type" "not in" (slice "tags" "categories" "search") -}}
{{- $result := slice -}}
{{- range $pages -}}
  {{- $content := .Plain | replaceRE "\\s+" " " | plainify -}}
  {{- $raw := .RawContent -}}
  {{- $optText := "" -}}

  {{- /* 1. 提取所有 opt-content 块内的文本（标准格式） */ -}}
  {{- $optBlocks := findRE `<div\s+class="opt-content"[^>]*?>([\s\S]*?)</div>` $raw -}}
  {{- range $optBlocks -}}
    {{- $text := replaceRE "<[^>]*>" "" . -}}
    {{- $text = replaceRE "\\s+" " " $text -}}
    {{- $optText = printf "%s %s" $optText $text -}}
  {{- end -}}

  {{- /* 2. 提取 paragraphMap 对象内的所有单引号/双引号字符串（烟火之邀格式） */ -}}
  {{- $mapBlock := findRE `paragraphMap\s*=\s*\{([\s\S]*?)\};` $raw -}}
  {{- with index $mapBlock 0 -}}
    {{- $mapStrings := findRE `'([^']*)'` . -}}
    {{- $mapStrings = $mapStrings | append (findRE `"([^"]*)"` .) -}}
    {{- range $mapStrings -}}
      {{- $clean := replaceRE `['"]` "" . -}}
      {{- $optText = printf "%s %s" $optText $clean -}}
    {{- end -}}
  {{- end -}}

  {{- $content = printf "%s %s" $content $optText -}}
  {{- $entry := dict "url" .RelPermalink "title" .Title "content" $content -}}
  {{- $result = $result | append $entry -}}
{{- end -}}
{{- $result | jsonify -}}