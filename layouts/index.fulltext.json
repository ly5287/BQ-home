{{- /* 生成完整纯文本搜索索引，包含 section 页面 */ -}}
{{- $pages := where site.Pages ".Params.pagefind" "!=" false -}}
{{- $pages = where $pages "Type" "not in" (slice "tags" "categories" "search") -}}
{{- $result := slice -}}
{{- range $pages -}}
  {{- $content := .Plain | replaceRE "\\s+" " " | plainify -}}
  {{- $entry := dict "url" .RelPermalink "title" .Title "content" $content -}}
  {{- $result = $result | append $entry -}}
{{- end -}}
{{- $result | jsonify -}}